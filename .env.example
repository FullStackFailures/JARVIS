# USE THIS  IN YOUR .env

# JARVIS runtime configuration
# Precedence: defaults < config.toml < .env < real environment.

JARVIS_POLICY__MODE=NORMAL
JARVIS_MODELS__DEFAULT_BACKEND=native

JARVIS_MODELS__OLLAMA__ENABLED=false
# JARVIS_MODELS__OLLAMA__MODEL=qwen2.5:7b

JARVIS_MODELS__REMOTE__ENABLED=false
# JARVIS_MODELS__REMOTE__BASE_URL=https://api.openai.com/v1
# JARVIS_MODELS__REMOTE__MODEL=
# JARVIS_MODELS__REMOTE__ALLOW_TASK_CONTENT=false

# JARVIS_REMOTE_API_KEY=